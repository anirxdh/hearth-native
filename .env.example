# RUA - local tooling keys (film production, asset generation).
#
# HOW TO USE
#   1. cp .env.example .env
#   2. paste your real keys into .env (NOT into this file)
#   3. .env is gitignored and never committed
#
# These are build/marketing tooling keys only. The RUA app itself ships with
# no network calls and no keys: every record stays on the phone, encrypted.

# ElevenLabs - voiceover and sound design for the product film.
# Get it at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# fal.ai - generative video and image b-roll for the film.
# Get it at https://fal.ai/dashboard/keys
FAL_KEY=
